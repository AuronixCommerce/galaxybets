{
  "rules": {
    ".read": false,
    ".write": false,
    "public": { ".read": true, ".write": false },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "walletViews": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "live": { ".read": true, ".write": false },
    "private": { ".read": false, ".write": false },
    "admin": { ".read": false, ".write": false }
  }
}
